set_property USED_IN_IMPLEMENTATION false $oldxdc
set proj_dir [get_property DIRECTORY [current_project]]
set proj_name [get_property NAME [current_project]]
set xdc_dir [file join $proj_dir "${proj_name}.srcs" sources_1 new]
file mkdir $xdc_dir
set xdc_file [file join $xdc_dir pynq_z2_dma_demo.xdc]
