# Get the current Vivado project location and name
set proj_dir  [get_property DIRECTORY [current_project]]
set proj_name [get_property NAME [current_project]]
# Create the new source folder if needed
set src_dir [file join $proj_dir "${proj_name}.srcs" sources_1 new]
file mkdir $src_dir
# Define the new SystemVerilog file
set src_file [file join $src_dir pynq_z2_dma_demo.sv]
# Create the file only if it does not already exist
if {![file exists $src_file]} {
    set fp [open $src_file w]
    puts $fp {`timescale 1ns / 1ps

module pynq_z2_dma_demo (
    input  wire clk,
    input  wire btn_reset,
    input  wire btn_start,
    output wire [3:0] led
);

    localparam [31:0] SRC_ADDR       = 32'h0000_0000;
    localparam [31:0] DST_ADDR       = 32'h0000_1000;
    localparam [31:0] TRANSFER_BYTES = 32'd256;

    assign led = 4'b0000;

endmodule
}
    close $fp
}
# Add the file to the current project
add_files -norecurse $src_file
set_property file_type SystemVerilog [get_files $src_file]
# Print the exact file location
puts "New source file: $src_file"
update_compile_order -fileset sources_1
get_files -all *pynq_z2_dma_demo.sv
set_property top axi4_dma_top [get_filesets sources_1]
update_compile_order -fileset sources_1
get_files -all *axi4_ram_slave.sv
set_property top pynq_z2_dma_demo [get_filesets sources_1]
update_compile_order -fileset sources_1
update_compile_order -fileset sources_1
